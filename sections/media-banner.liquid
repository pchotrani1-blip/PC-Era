{%- comment -%} PC ERA — Media banner (image or video) {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }} media-banner">
  <div class="wrap">
    <div class="media-banner__frame" style="aspect-ratio: {{ section.settings.ratio }};">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1600x' }}
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 2200 }}" alt="{{ section.settings.heading | default: shop.name | escape }}" loading="lazy" width="2200" height="1238">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}

      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank or section.settings.cta_text != blank -%}
        <div class="media-banner__overlay">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h-display">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
          {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link }}" class="btn btn--light">{{ section.settings.cta_text }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video (overrides image)" },
    { "type": "select", "id": "ratio", "label": "Shape", "options": [
      { "value": "16 / 9", "label": "Wide (16:9)" }, { "value": "3 / 2", "label": "Landscape (3:2)" }, { "value": "1 / 1", "label": "Square" }, { "value": "21 / 9", "label": "Cinematic (21:9)" }
    ], "default": "16 / 9" },
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }, { "value": "warm", "label": "Beige" }
    ], "default": "cream" },
    { "type": "header", "content": "Overlay text (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_text", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Media banner" }]
}
{% endschema %}
