{%- comment -%} PC ERA — Contact {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="wrap">
    <div class="split">
      <div class="split__body" data-reveal>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="h-display" style="margin-top:1rem">{{ section.settings.heading }}</h2>
        <div class="rte lead" style="margin-top:1rem">{{ section.settings.body }}</div>
        <div class="flow mt-3" style="font-size:.95rem">
          <p><strong>Email</strong> · <a class="link-underline" style="padding:0;text-transform:none;letter-spacing:0" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
          <p><strong>Phone / WhatsApp</strong> · <a class="link-underline" style="padding:0;text-transform:none;letter-spacing:0" href="tel:+91{{ section.settings.phone | remove: ' ' }}">+91 {{ section.settings.phone }}</a></p>
          <p><strong>Hours</strong> · {{ section.settings.hours }}</p>
        </div>
        {%- if section.settings.legal_name != blank or section.settings.address != blank or section.settings.gstin != blank -%}
          <div class="flow mt-3" style="font-size:.9rem;border-top:1px solid var(--line);padding-top:1rem">
            <p class="eyebrow" style="margin-bottom:.6rem">Registered business details</p>
            {%- if section.settings.legal_name != blank -%}<p><strong>Legal name</strong> · {{ section.settings.legal_name }}</p>{%- endif -%}
            {%- if section.settings.address != blank -%}<p><strong>Registered address</strong> · {{ section.settings.address | newline_to_br }}</p>{%- endif -%}
            {%- if section.settings.gstin != blank -%}<p><strong>GSTIN</strong> · {{ section.settings.gstin }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div data-reveal data-reveal-delay="0.1">
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="pill-badge">✦ Thank you — we'll be in touch within 24 hours.</p>
          {%- endif -%}
          <div class="flow">
            <input class="variant-pill" style="width:100%;text-align:left" type="text" name="contact[name]" placeholder="Your name" required>
            <input class="variant-pill" style="width:100%;text-align:left" type="email" name="contact[email]" placeholder="Email" required>
            <input class="variant-pill" style="width:100%;text-align:left" type="text" name="contact[subject]" placeholder="Subject">
            <textarea class="variant-pill" style="width:100%;min-height:160px;text-align:left;border-radius:6px" name="contact[body]" placeholder="How can we help?" required></textarea>
            <button type="submit" class="btn btn--block">Send message</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }, { "value": "warm", "label": "Beige" }
    ], "default": "ivory" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Say hello" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here for your era" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Questions about sizing, an order, or a styling dilemma? Our team replies within 24 hours, Monday to Friday.</p>" },
    { "type": "text", "id": "email", "label": "Email", "default": "Wearpcera@gmail.com" },
    { "type": "text", "id": "phone", "label": "Phone / WhatsApp", "default": "99901 26117" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Sat, 10am–6pm" },
    { "type": "header", "content": "Registered business details (as per GST)" },
    { "type": "text", "id": "legal_name", "label": "Legal name (as per GST certificate)", "default": "K. C. Creations Fabrics Private Limited" },
    { "type": "textarea", "id": "address", "label": "Registered address", "default": "II, C-8, Lajpat Nagar, Near Park Line, South Delhi, Delhi – 110024" },
    { "type": "text", "id": "gstin", "label": "GSTIN", "default": "07AAICK7230R1ZX" }
  ]
}
{% endschema %}
