{%- comment -%}
  PC ERA — "You may also like"
  Shows similar products. Renders an instant fallback from the same
  collection (so it ALWAYS shows something, even on a brand-new store),
  then upgrades to Shopify's product-recommendations engine
  (intent: related) client-side once those are available.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.limit
  # Pick a fallback source collection so the section is never empty.
  # 1. First real category collection the product belongs to
  assign rec_source = blank
  for c in product.collections
    unless c.handle == 'frontpage' or c.handle == 'all'
      assign rec_source = c
      break
    endunless
  endfor
  # 2. Any collection the product is in
  if rec_source == blank
    assign rec_source = product.collections.first
  endif
  # 3. Known catalog collections by handle
  assign fallback_handles = 'shop-all,new-arrivals,all,dresses,tops,co-ords,coords' | split: ','
  for h in fallback_handles
    if rec_source == blank or rec_source.all_products_count == 0
      assign rec_source = collections[h]
    endif
  endfor
  # 4. Last resort: first non-empty collection in the whole store
  if rec_source == blank or rec_source.all_products_count == 0
    for c in collections
      if c.all_products_count > 0 and c.handle != 'frontpage'
        assign rec_source = c
        break
      endif
    endfor
  endif
-%}

<section class="section bg-{{ section.settings.bg }}" data-product-recs
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&intent=related&limit={{ limit }}">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h-display">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="product-grid" data-recs-grid>
      {%- if recommendations.performed and recommendations.products.size > 0 -%}
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- assign shown = 0 -%}
        {%- for p in rec_source.products -%}
          {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {% render 'product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    function loadDeferred(track) {
      if (window.PCEraLoadDeferred) { window.PCEraLoadDeferred(track); return; }
      track.querySelectorAll('img.pc-defer').forEach(function (im) {
        if (im.dataset.src) im.src = im.dataset.src;
        if (im.dataset.srcset) im.srcset = im.dataset.srcset;
        im.classList.remove('pc-defer');
      });
    }
    function initCards(root) {
      root.querySelectorAll('[data-pc-track]').forEach(function (track) {
        var media = track.closest('.product-card__media'); if (!media) return;
        var dots = media.querySelectorAll('.pc-dot');
        var prev = media.querySelector('[data-pc-prev]');
        var next = media.querySelector('[data-pc-next]');
        var go = function (d) { loadDeferred(track); track.scrollBy({ left: d * track.clientWidth, behavior: 'smooth' }); };
        if (prev) prev.addEventListener('click', function (e) { e.preventDefault(); go(-1); });
        if (next) next.addEventListener('click', function (e) { e.preventDefault(); go(1); });
        ['pointerenter', 'touchstart', 'focusin'].forEach(function (evt) {
          media.addEventListener(evt, function () { loadDeferred(track); }, { once: true, passive: true });
        });
        track.addEventListener('scroll', function () { loadDeferred(track); }, { once: true, passive: true });
        if (dots.length) {
          track.addEventListener('scroll', function () {
            var i = Math.round(track.scrollLeft / track.clientWidth);
            dots.forEach(function (dd, di) { dd.classList.toggle('is-active', di === i); });
          }, { passive: true });
        }
      });
    }
    document.querySelectorAll('[data-product-recs]').forEach(function (sec) {
      if (sec.dataset.recsLoaded) return;
      sec.dataset.recsLoaded = '1';
      var url = sec.getAttribute('data-url');
      if (!url) return;
      // Upgrade the fallback to Shopify's real recommendations when available.
      fetch(url).then(function (r) { return r.ok ? r.text() : ''; }).then(function (t) {
        if (!t) return;
        var doc = new DOMParser().parseFromString(t, 'text/html');
        var freshGrid = doc.querySelector('[data-recs-grid]');
        var curGrid = sec.querySelector('[data-recs-grid]');
        // Only replace if Shopify returned real recommendation cards.
        if (freshGrid && curGrid && freshGrid.querySelector('.product-card')) {
          curGrid.innerHTML = freshGrid.innerHTML;
          initCards(curGrid);
        }
      }).catch(function () {});
    });
  })();
</script>

{% schema %}
{
  "name": "You may also like",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }, { "value": "warm", "label": "Beige" }
    ], "default": "ivory" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You may also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Similar styles" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "You may also like" }]
}
{% endschema %}
