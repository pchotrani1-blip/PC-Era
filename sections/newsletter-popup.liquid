{%- comment -%} PC ERA — Newsletter popup {%- endcomment -%}
{%- if section.settings.enabled -%}
<div class="nl-popup" id="nlPopup" aria-hidden="true">
  <div class="nl-popup__overlay" data-nlp-close></div>
  <div class="nl-popup__card" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
    <button class="nl-popup__close icon-btn" data-nlp-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h3 class="h-display">{{ section.settings.heading | replace: 'Era', '<em class="accent-italic">Era</em>' }}</h3>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    {%- form 'customer', data-newsletter: true -%}
      <input type="hidden" name="contact[tags]" value="newsletter,popup">
      {%- comment -%} Success block: hidden until subscribe succeeds (shown by JS, or by Liquid on reload fallback) {%- endcomment -%}
      <div class="nl-success" data-nl-success {% unless form.posted_successfully? %}hidden{% endunless %}>
        <p class="nl-success__msg">{{ section.settings.success_message }}</p>
        {%- if section.settings.success_code != blank -%}
          <button type="button" class="nl-code" data-nl-code aria-label="Copy discount code">
            <span class="nl-code__value">{{ section.settings.success_code }}</span>
            <span class="nl-code__hint">Tap to copy</span>
          </button>
        {%- endif -%}
      </div>
      <div class="nl-field" data-nl-field {% if form.posted_successfully? %}hidden{% endif %}>
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required aria-label="Email address">
        <button type="submit">{{ section.settings.button }} <span aria-hidden="true">&#8599;</span></button>
      </div>
    {%- endform -%}
    <button type="button" class="nl-popup__dismiss" data-nlp-close>{{ section.settings.dismiss_text }}</button>
  </div>
</div>
<script>
(function(){
  var KEY = 'pcera_nlp_dismissed';
  var pop = document.getElementById('nlPopup');
  if(!pop) return;
  var delay = {{ section.settings.delay | default: 6 }} * 1000;
  function open(){ pop.classList.add('is-open'); pop.setAttribute('aria-hidden','false'); }
  function close(){ pop.classList.remove('is-open'); pop.setAttribute('aria-hidden','true'); try{ localStorage.setItem(KEY,'1'); }catch(e){} }
  try{ if(localStorage.getItem(KEY)) return; }catch(e){}
  setTimeout(open, delay);
  pop.querySelectorAll('[data-nlp-close]').forEach(function(el){ el.addEventListener('click', close); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') close(); });

  var form    = pop.querySelector('form');
  var field   = pop.querySelector('[data-nl-field]');
  var success = pop.querySelector('[data-nl-success]');
  var codeBtn = pop.querySelector('[data-nl-code]');

  // Tap-to-copy the code
  if(codeBtn){
    codeBtn.addEventListener('click', function(){
      var val = codeBtn.querySelector('.nl-code__value').textContent.trim();
      var hint = codeBtn.querySelector('.nl-code__hint');
      function done(){ if(hint){ hint.textContent = 'Copied ✓'; } codeBtn.classList.add('is-copied'); }
      try { navigator.clipboard.writeText(val).then(done, done); } catch(e){ done(); }
    });
  }

  function reveal(){
    if(field) field.setAttribute('hidden','');
    if(success) success.removeAttribute('hidden');
    try{ localStorage.setItem('pcera_nlp_subscribed','1'); }catch(e){}
  }

  // Reveal the code the moment they subscribe — no page reload
  if(form){
    form.addEventListener('submit', function(e){
      var emailInput = form.querySelector('input[type=email]');
      if(emailInput && !emailInput.checkValidity()) return; // let browser show the error
      e.preventDefault();
      var btn = form.querySelector('button[type=submit]');
      if(btn){ btn.disabled = true; btn.style.opacity = '.6'; }
      fetch(form.action, { method:'POST', body:new FormData(form), headers:{'Accept':'application/json'} })
        .then(function(){ reveal(); })
        .catch(function(){ reveal(); }); // Shopify still records the signup; show the reward regardless
    });
  }

  // Already subscribed earlier (Liquid reload fallback or returning visitor) -> show the code
  if(success && !success.hasAttribute('hidden')) open();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable popup", "default": true },
    { "type": "range", "id": "delay", "label": "Show after", "min": 0, "max": 30, "step": 1, "unit": "s", "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Era." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Early access to new drops, private sales and quiet inspiration — straight to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button", "label": "Button", "default": "Subscribe" },
    { "type": "text", "id": "dismiss_text", "label": "Dismiss text", "default": "No thanks" },
    { "type": "header", "content": "After subscribing" },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "You're in. Here's your 10% off — copy the code and use it at checkout:" },
    { "type": "text", "id": "success_code", "label": "Discount code to reveal", "info": "Leave blank to hide. Make sure this matches a real discount in Shopify → Discounts.", "default": "WELCOME10" }
  ]
}
{% endschema %}
