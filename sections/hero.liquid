{%- comment -%} PC ERA — Editorial hero {%- endcomment -%}
<section class="hero {% if section.settings.light_text == false %}hero--light{% endif %}">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.image.alt | escape }}" width="2400" height="1500" fetchpriority="high">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="hero__scrim"></div>
  <div class="wrap">
    <div class="hero__inner">
      <span class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>
      <h1 data-reveal data-reveal-delay="0.08">{{ section.settings.heading }}</h1>
      <p class="lead" data-reveal data-reveal-delay="0.16">{{ section.settings.subheading }}</p>
      <div class="hero__cta" data-reveal data-reveal-delay="0.24">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--light">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--ghost" style="color:var(--ivory);border-color:rgba(252,250,244,.6)">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  <span class="scroll-cue">Scroll</span>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "video", "id": "video", "label": "Background video (optional)" },
    { "type": "checkbox", "id": "light_text", "label": "Light text", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Summer ’26 — Now arriving" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The Era of Trend" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Affordable luxury made to dress every version of her. Soft, confident, on holiday, and everywhere in between." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop new in" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "Discover PC Era" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
