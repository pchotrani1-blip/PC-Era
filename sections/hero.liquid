{%- comment -%} PC ERA — Editorial hero (Summer '26) {%- endcomment -%}
<section class="hero-ed">
  {%- if section.settings.image != blank -%}
    <div class="hero-ed__photo">
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}" width="1800" height="2000" fetchpriority="high">
    </div>
  {%- endif -%}

  {%- if section.settings.est_text != blank -%}
    <span class="hero-ed__est">{{ section.settings.est_text }}</span>
  {%- endif -%}

  <div class="wrap">
    <div class="hero-ed__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow hero-ed__eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero-ed__title" data-reveal data-reveal-delay="0.08">
        <span class="hero-ed__title-main">{{ section.settings.heading }}</span>
        {%- if section.settings.heading_accent != blank -%}
          <span class="hero-ed__title-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero-ed__lead" data-reveal data-reveal-delay="0.16">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero-ed__cta" data-reveal data-reveal-delay="0.24">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn">{{ section.settings.cta_text }} <span aria-hidden="true">&#8599;</span></a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--ghost">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero photo (right side)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Summer Edit — Vol. 26" },
    { "type": "text", "id": "heading", "label": "Heading (main)", "default": "Summer" },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent, gold)", "default": "’26." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Made for slow mornings, golden hours and every era of yours." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop collection" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "Explore new arrivals" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "est_text", "label": "Side text", "default": "PC ERA — Est. 2026" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
