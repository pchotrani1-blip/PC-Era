{%- comment -%} PC ERA — Header (seal logo + thin nav) {%- endcomment -%}
{%- if section.settings.announcement != blank -%}
  <div class="announcement">{{ section.settings.announcement }}</div>
{%- endif -%}

<header class="site-header">
  <div class="wrap">
    <div class="header-bar">
      <div class="left" style="display:flex;align-items:center;gap:1rem">
        <button class="icon-btn nav-toggle" data-nav-open aria-label="{{ 'accessibility.menu' | t }}">{% render 'icon', name: 'menu' %}</button>
        <a href="{{ routes.account_url }}" class="link-underline" style="padding:0">Log In</a>
      </div>

      <a href="{{ routes.root_url }}" class="brand-wordmark" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" width="120" style="height:48px;width:auto;object-fit:contain">
        {%- else -%}
          {% render 'seal', size: 96 %}
        {%- endif -%}
      </a>

      <div class="header-utils">
        <a href="{{ routes.search_url }}" class="icon-btn" aria-label="{{ 'accessibility.search' | t }}">{% render 'icon', name: 'search' %}</a>
        <a href="{{ routes.account_url }}#wishlist" class="icon-btn" aria-label="{{ 'accessibility.wishlist' | t }}">{% render 'icon', name: 'heart' %}<span class="cart-count" data-wish-count>0</span></a>
        <button class="icon-btn" data-cart-open aria-label="{{ 'accessibility.cart' | t }}">{% render 'icon', name: 'cart' %}<span class="cart-count">{{ cart.item_count }}</span></button>
      </div>
    </div>

    <nav class="header-nav" aria-label="Primary">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (leave blank to use rotating seal)" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "announcement", "label": "Announcement bar", "default": "Complimentary shipping over ₹2,500 · The Era of Trend" }
  ]
}
{% endschema %}
