{%- comment -%} PC ERA — Header {%- endcomment -%}
{%- if section.settings.announcement != blank -%}
  {%- capture ann_heart -%}<svg class="announcement__heart" viewBox="0 0 24 24" width="13" height="13" role="img" aria-hidden="true"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>{%- endcapture -%}
  <div class="announcement">
    <span class="announcement__sr">{{ section.settings.announcement }}</span>
    <div class="announcement__track" aria-hidden="true">
      {%- for i in (1..8) -%}
        <span class="announcement__item">{{ section.settings.announcement }}</span>
        <span class="announcement__sep">{{ ann_heart }}</span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<header class="site-header">
  <div class="wrap">
    <div class="header-bar">
      <div class="header-left">
        <button class="icon-btn nav-toggle" data-nav-open aria-label="{{ 'accessibility.menu' | t }}">{% render 'icon', name: 'menu' %}</button>
        <a href="{{ routes.search_url }}" class="icon-btn" aria-label="{{ 'accessibility.search' | t }}">{% render 'icon', name: 'search' %}</a>
        <nav class="header-nav" aria-label="Primary">
          {%- for link in linklists[section.settings.menu].links -%}
            {%- if link.links.size > 0 -%}
              <details class="nav-group">
                <summary>{{ link.title }}<span class="nav-plus" aria-hidden="true"></span></summary>
                <div class="nav-submenu">
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>
                  {%- endfor -%}
                </div>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      </div>

      <a href="{{ routes.root_url }}" class="brand-wordmark" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160">
        {%- else -%}
          <img src="{{ 'pc-era-logo.png' | asset_url }}" alt="{{ shop.name }}" width="160">
        {%- endif -%}
      </a>

      <div class="header-utils">
        <a href="{{ routes.account_url }}" class="link-underline header-login">Log In</a>
        <a href="{{ routes.account_url }}#wishlist" class="icon-btn" aria-label="{{ 'accessibility.wishlist' | t }}">
          {% render 'icon', name: 'heart' %}<span class="cart-count" data-wish-count>0</span>
        </a>
        <button class="icon-btn" data-cart-open aria-label="{{ 'accessibility.cart' | t }}">
          {% render 'icon', name: 'cart' %}<span class="cart-count">{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "announcement", "label": "Announcement bar", "default": "Summer '26 now live — Sign up to our newsletter to enter this era" }
  ]
}
{% endschema %}
