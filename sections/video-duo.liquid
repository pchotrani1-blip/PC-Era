{%- comment -%} PC ERA — Two videos side-by-side with centered text {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }} video-duo">
  <div class="wrap">
    <div class="video-duo__grid">

      <div class="video-duo__media" style="aspect-ratio: {{ section.settings.ratio }};">
        {%- if section.settings.video_left != blank -%}
          {{ section.settings.video_left | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1100x' }}
        {%- elsif section.settings.image_left != blank -%}
          <img src="{{ section.settings.image_left | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="video-duo__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h-display video-duo__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link }}" class="btn">{{ section.settings.cta_text }}</a>{%- endif -%}
      </div>

      <div class="video-duo__media" style="aspect-ratio: {{ section.settings.ratio }};">
        {%- if section.settings.video_right != blank -%}
          {{ section.settings.video_right | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1100x' }}
        {%- elsif section.settings.image_right != blank -%}
          <img src="{{ section.settings.image_right | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Two videos + text",
  "settings": [
    { "type": "header", "content": "Left media" },
    { "type": "video", "id": "video_left", "label": "Left video" },
    { "type": "image_picker", "id": "image_left", "label": "Left image (fallback)" },
    { "type": "header", "content": "Right media" },
    { "type": "video", "id": "video_right", "label": "Right video" },
    { "type": "image_picker", "id": "image_right", "label": "Right image (fallback)" },
    { "type": "header", "content": "Centre text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Summer Collection" },
    { "type": "textarea", "id": "text", "label": "Body text", "default": "Soft silhouettes, golden-hour tones and pieces made for every era of your summer." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "ratio", "label": "Video shape", "options": [
      { "value": "3 / 4", "label": "Portrait (3:4)" }, { "value": "4 / 5", "label": "Portrait (4:5)" }, { "value": "9 / 16", "label": "Tall (9:16)" }, { "value": "1 / 1", "label": "Square" }
    ], "default": "3 / 4" },
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }, { "value": "warm", "label": "Beige" }, { "value": "butter", "label": "Butter" }
    ], "default": "ivory" }
  ],
  "presets": [{ "name": "Two videos + text" }]
}
{% endschema %}
