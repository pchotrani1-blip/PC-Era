{%- comment -%} PC ERA — Journal index {%- endcomment -%}
<section class="section--tight bg-warm">
  <div class="wrap text-center" data-reveal>
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="h-hero" style="margin-top:.5rem">{{ blog.title }}</h1>
    <p class="lead" style="max-width:560px;margin:1rem auto 0">{{ section.settings.subheading }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {%- paginate blog.articles by 9 -%}
      <div class="product-grid">
        {%- for article in blog.articles -%}
          <article class="product-card" data-reveal data-reveal-delay="{{ forloop.index0 | modulo: 3 | times: 0.06 }}">
            <a href="{{ article.url }}" class="product-card__media" style="aspect-ratio:4/5">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy" width="800" height="1000">
              {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
            </a>
            <div class="product-card__info" style="gap:.4rem">
              <span class="eyebrow">{{ article.tags.first | default: 'Journal' }}</span>
              <a href="{{ article.url }}"><h3 style="font-size:1.25rem">{{ article.title }}</h3></a>
              <p class="muted" style="font-size:.85rem">{{ article.excerpt_or_content | strip_html | truncate: 90 }}</p>
              <span class="link-underline" style="font-size:.75rem;margin-top:.4rem">Read more</span>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.next -%}<div class="text-center mt-4"><a href="{{ paginate.next.url }}" class="btn btn--ghost">More stories</a></div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Editorials, travel guides, trend reports and how-to-style edits — for every era of her." }
  ]
}
{% endschema %}
