{%- comment -%} PC ERA — Size chart {%- endcomment -%}
<section class="section size-chart">
  <div class="wrap">
    <div class="size-chart__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="h-display">{{ section.settings.heading | replace: 'Chart', '<em class="accent-italic">Chart</em>' }}</h1>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="lead">{{ section.settings.intro }}</p>{%- endif -%}
    </div>
    <div class="size-table-wrap">
      <table class="size-table">
        <thead>
          <tr>
            <th>Main Range</th><th>XS</th><th>S</th><th>M</th><th>L</th><th>XL</th><th>XXL</th><th>3XL</th>
          </tr>
        </thead>
        <tbody>
          <tr><th>UK</th><td>4</td><td>6</td><td>8</td><td>10</td><td>12</td><td>14</td><td>16</td></tr>
          <tr><th>EU</th><td>4</td><td>6</td><td>8</td><td>10</td><td>12</td><td>14</td><td>16</td></tr>
          <tr><th>USA / CA</th><td>0</td><td>2</td><td>4</td><td>6</td><td>8</td><td>10</td><td>12</td></tr>
          <tr><th>AUS</th><td>4</td><td>6</td><td>8</td><td>10</td><td>12</td><td>14</td><td>16</td></tr>
          <tr><th>FR</th><td>32</td><td>34</td><td>36</td><td>38</td><td>40</td><td>42</td><td>44</td></tr>
          <tr><th>Bust</th><td>31.5</td><td>32.5</td><td>33.5</td><td>35.5</td><td>37.5</td><td>39.5</td><td>41.5</td></tr>
          <tr><th>Waist</th><td>24.5</td><td>25.5</td><td>26.5</td><td>28.5</td><td>30.5</td><td>32.5</td><td>34.5</td></tr>
          <tr><th>Low Hip</th><td>34.5</td><td>35.5</td><td>36.5</td><td>38.5</td><td>40.5</td><td>42.5</td><td>44.5</td></tr>
        </tbody>
      </table>
    </div>
    {%- if section.settings.footnote != blank -%}<p class="muted mt-3" style="font-size:.85rem">{{ section.settings.footnote }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Size chart",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The fit guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size Chart" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Body measurements in inches. If you're between sizes, we recommend sizing up for a softer, more relaxed fit." },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Measurements are a guide only and may vary slightly by style. Need help? Email wearpcera@gmail.com." }
  ],
  "presets": [{ "name": "Size chart" }]
}
{% endschema %}
