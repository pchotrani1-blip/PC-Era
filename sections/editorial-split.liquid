{%- comment -%} PC ERA — Editorial split (founder story / brand statement) {%- endcomment -%}
{%- if section.settings.compact -%}
  <section class="section section--tight bg-{{ section.settings.bg }}">
    <div class="wrap">
      <div class="editorial-compact" data-reveal>
        {%- if section.settings.image != blank -%}<img class="editorial-compact__img" src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">{%- endif -%}
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h-display">{{ section.settings.heading }}</h2>{%- endif -%}
        <div class="rte">{{ section.settings.body }}</div>
        {%- if section.settings.signature != blank -%}<p class="italic-accent">{{ section.settings.signature }}</p>{%- endif -%}
        {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link }}" class="btn">{{ section.settings.cta_text }}</a>{%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="wrap">
    <div class="split {% if section.settings.reverse %}split--reverse{% endif %}">
      <div class="split__media" data-reveal>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="1200" height="1500">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="split__body" data-reveal data-reveal-delay="0.1">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="h-display" style="margin-top:1rem">{{ section.settings.heading }}</h2>
        <div class="rte" style="color:var(--ink-soft)">{{ section.settings.body }}</div>
        {%- if section.settings.signature != blank -%}
          <p class="italic-accent" style="font-size:1.4rem;margin-top:1.5rem">{{ section.settings.signature }}</p>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "checkbox", "id": "compact", "label": "Compact (small, centered — no image)", "default": false },
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }, { "value": "warm", "label": "Beige" }, { "value": "butter", "label": "Butter" }
    ], "default": "warm" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In my PC Era" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every girl moves through eras. The confident one. The soft one. The healing one. The main character one. PC Era exists to dress every version of her — so getting dressed feels like a moment, not an afterthought.</p>" },
    { "type": "text", "id": "signature", "label": "Signature line", "default": "— Founded for the girl becoming herself." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Read our story" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Editorial split" }]
}
{% endschema %}
