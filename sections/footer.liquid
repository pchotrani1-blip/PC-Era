{%- comment -%} PC ERA — Footer {%- endcomment -%}
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="{{ 'pc-era-logo.png' | asset_url }}" alt="{{ shop.name }}" width="120" style="height:64px;width:auto;object-fit:contain;">
        <div class="visually-hidden">PC Era</div>
        <p>{{ section.settings.tagline | default: 'The Era of Trend. Affordable luxury made to dress every version of her — confident, soft, on holiday, and everything in between.' }}</p>
        {%- if section.settings.email != blank or section.settings.phone != blank -%}
          <div style="margin-top:1.2rem;font-size:.8rem;display:grid;gap:.3rem">
            {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{%- endif -%}
            {%- if section.settings.phone != blank -%}<a href="tel:+91{{ section.settings.phone | remove: ' ' }}">+91 {{ section.settings.phone }}</a>{%- endif -%}
          </div>
        {%- endif -%}
        <div style="display:flex;gap:1rem;margin-top:1.5rem;">
          <a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          <a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          <a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>
        </div>
      </div>
      {%- for block in section.blocks -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. In your PC Era.</span>
      <div class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Brand line" },
    { "type": "text", "id": "email", "label": "Contact email", "default": "Wearpcera@gmail.com" },
    { "type": "text", "id": "phone", "label": "Contact phone", "default": "99901 26117" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "menu", "settings": { "heading": "House" } }
    ]
  }
}
{% endschema %}
