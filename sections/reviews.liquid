{%- comment -%} PC ERA — Customer reviews / social proof {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h-display">{{ section.settings.heading }}</h2>
      <p><span class="stars">★★★★★</span> {{ section.settings.rating_line }}</p>
    </div>
    <div class="review-grid">
      {%- for block in section.blocks -%}
        <figure class="review-card" data-reveal data-reveal-delay="{{ forloop.index0 | times: 0.07 }}" {{ block.shopify_attributes }}>
          <span class="stars">★★★★★</span>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <cite>{{ block.settings.author }}{% if block.settings.detail != blank %} · {{ block.settings.detail }}{% endif %}</cite>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "warm", "label": "Beige" }, { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }
    ], "default": "warm" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by the era" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "She said it best" },
    { "type": "text", "id": "rating_line", "label": "Rating line", "default": "4.9 / 5 from 2,400+ reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The quality genuinely feels designer. I wore the linen set to brunch and got asked where it's from all day." },
        { "type": "text", "id": "author", "label": "Author", "default": "Olivia R." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [{
    "name": "Reviews",
    "blocks": [
      { "type": "review", "settings": { "quote": "The quality genuinely feels designer. Wore the linen set to brunch and got asked where it's from all day.", "author": "Olivia R." } },
      { "type": "review", "settings": { "quote": "Finally a brand that looks like my Pinterest board. The fit is so flattering and the fabric is buttery.", "author": "Maya T." } },
      { "type": "review", "settings": { "quote": "Packaging alone made me feel like the main character. Will absolutely order again for my Europe trip.", "author": "Sienna L." } }
    ]
  }]
}
{% endschema %}
