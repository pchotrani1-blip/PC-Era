{%- comment -%} PC ERA — Collection list (shop landing) {%- endcomment -%}
<section class="section">
  <div class="wrap">
    <div class="collection-tiles" style="grid-template-columns:repeat(3,1fr)">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign c = collections[block.settings.collection] -%}
          <a href="{{ c.url | default: '#' }}" class="collection-tile" data-reveal data-reveal-delay="{{ forloop.index0 | times: 0.05 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy" width="800" height="1066">
            {%- elsif c.image != blank -%}
              <img src="{{ c.image | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy" width="800" height="1066">
            {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
            <span class="collection-tile__label"><h3>{{ block.settings.title | default: c.title }}</h3><span>{{ c.products_count }} pieces</span></span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections limit: 9 -%}
          <a href="{{ c.url }}" class="collection-tile" data-reveal>
            {%- if c.image != blank -%}<img src="{{ c.image | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy">{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
            <span class="collection-tile__label"><h3>{{ c.title }}</h3><span>{{ c.products_count }} pieces</span></span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Override title" },
        { "type": "image_picker", "id": "image", "label": "Override image" }
      ]
    }
  ],
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
