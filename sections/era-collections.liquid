{%- comment -%} PC ERA — Made for every era (colour-block tiles, swipeable) {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }} era-sec">
  <div class="wrap">
    <div class="na-slider__head">
      <div class="na-slider__intro">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h-display">{{ section.settings.heading | replace: 'every', '<em class="accent-italic">every</em>' }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="na-slider__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      <div class="na-slider__nav">
        <button type="button" class="na-arrow" aria-label="Previous" data-slide-prev>&#8592;</button>
        <button type="button" class="na-arrow" aria-label="Next" data-slide-next>&#8594;</button>
      </div>
    </div>

    <div class="era-track" data-slider>
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="era-tile{% if block.settings.image != blank %} era-tile--img{% endif %}" style="background: {{ block.settings.color | default: '#EDE6D8' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img class="era-tile__bg" src="{{ block.settings.image | image_url: width: 800 }}" srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 800 }} 800w" sizes="(max-width:600px) 74vw, 33vw" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- endif -%}
          <span class="era-tile__kicker">{{ block.settings.kicker }}</span>
          <span class="era-tile__foot">
            <span class="era-tile__title">{{ block.settings.title }}</span>
            <span class="era-tile__shop">Shop the era <span aria-hidden="true">&#8594;</span></span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
(function(){
  var sec = document.currentScript.previousElementSibling;
  if(!sec) return;
  var track = sec.querySelector('[data-slider]');
  if(!track) return;
  function step(){ var it = track.querySelector('.era-tile'); return it ? it.getBoundingClientRect().width + 20 : 320; }
  var p = sec.querySelector('[data-slide-prev]'), n = sec.querySelector('[data-slide-next]');
  if(p) p.addEventListener('click', function(){ track.scrollBy({left:-step(), behavior:'smooth'}); });
  if(n) n.addEventListener('click', function(){ track.scrollBy({left:step(), behavior:'smooth'}); });
})();
</script>

{% schema %}
{
  "name": "Era collections",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "cream", "label": "Cream" }, { "value": "warm", "label": "Beige" }
    ], "default": "ivory" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your era" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for every era" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Whichever version of her is showing up today." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Vacation era" },
        { "type": "text", "id": "title", "label": "Title", "default": "Resort & Vacation" },
        { "type": "image_picker", "id": "image", "label": "Tile image", "info": "Recommended 800×1000. Shown instead of the tile colour." },
        { "type": "color", "id": "color", "label": "Tile colour (fallback)", "default": "#EDE6D8" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Era collections",
    "blocks": [
      { "type": "tile", "settings": { "kicker": "Vacation era", "title": "Resort & Vacation", "color": "#CFD9DE" } },
      { "type": "tile", "settings": { "kicker": "Main character era", "title": "Dresses", "color": "#F1E2E0" } },
      { "type": "tile", "settings": { "kicker": "Off-duty", "title": "Matching Sets", "color": "#E0E5D8" } }
    ]
  }]
}
{% endschema %}
