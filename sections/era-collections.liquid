{%- comment -%} PC ERA — Made for every era (collection tiles) {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h-display">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="collection-tiles">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="collection-tile" data-reveal data-reveal-delay="{{ forloop.index0 | times: 0.06 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="1066">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="collection-tile__label">
            <span class="eyebrow" style="color:var(--butter)">{{ block.settings.kicker }}</span>
            <h3>{{ block.settings.title }}</h3>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Era collections",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "cream", "label": "Cream" }, { "value": "warm", "label": "Beige" }
    ], "default": "ivory" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your era" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for every era" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Whichever version of her is showing up today." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Vacation era" },
        { "type": "text", "id": "title", "label": "Title", "default": "Resort & Vacation" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Era collections",
    "blocks": [
      { "type": "tile", "settings": { "kicker": "Vacation era", "title": "Resort & Vacation" } },
      { "type": "tile", "settings": { "kicker": "Main character era", "title": "Dresses" } },
      { "type": "tile", "settings": { "kicker": "Brunch era", "title": "Matching Sets" } }
    ]
  }]
}
{% endschema %}
