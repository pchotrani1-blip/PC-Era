{%- comment -%} PC ERA — Made for every era (bordered era cards) {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h-display">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="eras">
      {%- for block in section.blocks -%}
        <div class="era" data-reveal data-reveal-delay="{{ forloop.index0 | times: 0.07 }}" {{ block.shopify_attributes }}>
          <div class="num">{{ block.settings.numeral }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
          {%- if block.settings.cta != blank -%}<a href="{{ block.settings.link }}" class="btn"><span>{{ block.settings.cta }}</span></a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Era collections",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }, { "value": "butter", "label": "Butter" }
    ], "default": "cream" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your era" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for every era" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Whichever version of her is showing up today." }
  ],
  "blocks": [
    {
      "type": "era",
      "name": "Era card",
      "settings": [
        { "type": "text", "id": "numeral", "label": "Numeral", "default": "i" },
        { "type": "text", "id": "title", "label": "Title", "default": "Vacation Era" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Airport to aperitivo. Linen and crochet made for European summer." },
        { "type": "text", "id": "cta", "label": "Button", "default": "Shop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Era collections",
    "blocks": [
      { "type": "era", "settings": { "numeral": "i", "title": "Vacation Era" } },
      { "type": "era", "settings": { "numeral": "ii", "title": "Main Character Era" } },
      { "type": "era", "settings": { "numeral": "iii", "title": "Brunch Era" } }
    ]
  }]
}
{% endschema %}
