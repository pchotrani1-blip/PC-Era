{%- comment -%} PC ERA — Collection / PLP {%- endcomment -%}
{%- comment -%} Banner priority: editor hero slot → collection's own image → default banner {%- endcomment -%}
{%- assign banner = '' -%}
{%- case collection.handle -%}
  {%- when 'dresses' -%}{%- assign banner = section.settings.banner_dresses -%}
  {%- when 'tops' -%}{%- assign banner = section.settings.banner_tops -%}
  {%- when 'skirts' -%}{%- assign banner = section.settings.banner_skirts -%}
  {%- when 'trousers' -%}{%- assign banner = section.settings.banner_trousers -%}
  {%- when 'co-ord-sets' -%}{%- assign banner = section.settings.banner_coords -%}
  {%- when 'new-arrivals' -%}{%- assign banner = section.settings.banner_new_arrivals -%}
  {%- when 'shop-all' -%}{%- assign banner = section.settings.banner_shop_all -%}
{%- endcase -%}
{%- assign banner = banner | default: collection.image | default: section.settings.default_banner -%}
<section class="collection-hero{% unless banner != blank %} collection-hero--plain{% endunless %}">
  {%- if banner != blank -%}
    <img src="{{ banner | image_url: width: 2000 }}" alt="{{ collection.title | escape }}" width="2000" height="700" loading="eager">
    <div class="hero__scrim"></div>
  {%- endif -%}
  <div class="collection-hero__inner wrap" {% unless banner != blank %}style="color:var(--ink)"{% endunless %}>
    <span class="eyebrow">{{ section.settings.eyebrow | default: 'The collection' }}</span>
    <h1 class="h-display" {% unless banner != blank %}style="color:var(--ink)"{% endunless %}>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p class="lead" style="max-width:560px;margin:1rem auto 0;{% if banner != blank %}color:rgba(252,250,244,.9){% endif %}">{{ collection.description | strip_html | truncate: 100 }}</p>{%- endif -%}
  </div>
</section>

<div class="wrap">
  <div class="collection-toolbar">
    <div class="filter-pills">
      <a href="{{ collection.url }}" class="filter-pill {% unless current_tags %}is-active{% endunless %}">All</a>
      {%- for tag in collection.all_tags limit: 8 -%}
        <a href="{{ collection.url }}/{{ tag | handle }}" class="filter-pill {% if current_tags contains tag %}is-active{% endif %}">{{ tag }}</a>
      {%- endfor -%}
    </div>
    <form>
      <select class="sort-select" name="sort_by" onchange="this.form.submit()">
        {%- assign sort = collection.sort_by | default: collection.default_sort_by -%}
        <option value="manual" {% if sort == 'manual' %}selected{% endif %}>Featured</option>
        <option value="best-selling" {% if sort == 'best-selling' %}selected{% endif %}>Best selling</option>
        <option value="price-ascending" {% if sort == 'price-ascending' %}selected{% endif %}>Price: low to high</option>
        <option value="price-descending" {% if sort == 'price-descending' %}selected{% endif %}>Price: high to low</option>
        <option value="created-descending" {% if sort == 'created-descending' %}selected{% endif %}>New arrivals</option>
      </select>
    </form>
  </div>
</div>

<section class="section--tight">
  <div class="wrap">
    {%- assign pin_first = all_products[section.settings.pin_first_tops] -%}
    {%- assign pin_last = all_products[section.settings.pin_last_tops] -%}
    {%- assign do_pin = false -%}
    {%- if collection.handle == 'tops' and current_tags == blank -%}{%- assign do_pin = true -%}{%- endif -%}
    {%- paginate collection.products by 24 -%}
      <div class="product-grid">
        {%- if do_pin and paginate.current_page == 1 and section.settings.pin_first_tops != blank and pin_first != empty -%}
          {% render 'product-card', product: pin_first %}
        {%- endif -%}
        {%- for product in collection.products -%}
          {%- if do_pin and pin_first != empty and product.id == pin_first.id -%}{%- continue -%}{%- endif -%}
          {%- if do_pin and pin_last != empty and product.id == pin_last.id -%}{%- continue -%}{%- endif -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          {%- unless do_pin -%}<p class="muted">No pieces in this era yet — check back soon.</p>{%- endunless -%}
        {%- endfor -%}
        {%- if do_pin and paginate.current_page == paginate.pages and section.settings.pin_last_tops != blank and pin_last != empty -%}
          {% render 'product-card', product: pin_last %}
        {%- endif -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="text-center mt-4">
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--ghost">Load more</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "image_picker", "id": "default_banner", "label": "Default banner image", "info": "Fallback shown on any collection that has no hero image set below (and no image of its own). A collection's own image, set in Collections → edit → Image, always wins." },
    { "type": "header", "content": "Hero image per collection" },
    { "type": "paragraph", "content": "Pick a banner for each collection. Leave blank to use the default banner above." },
    { "type": "image_picker", "id": "banner_new_arrivals", "label": "New Arrivals hero" },
    { "type": "image_picker", "id": "banner_shop_all", "label": "Shop All hero" },
    { "type": "image_picker", "id": "banner_dresses", "label": "Dresses hero" },
    { "type": "image_picker", "id": "banner_tops", "label": "Tops hero" },
    { "type": "image_picker", "id": "banner_skirts", "label": "Skirts hero" },
    { "type": "image_picker", "id": "banner_trousers", "label": "Trousers hero" },
    { "type": "image_picker", "id": "banner_coords", "label": "Co-ord Sets hero" },
    { "type": "header", "content": "Product order — Tops collection" },
    { "type": "product", "id": "pin_first_tops", "label": "Tops: show this product first" },
    { "type": "product", "id": "pin_last_tops", "label": "Tops: show this product last" }
  ]
}
{% endschema %}
