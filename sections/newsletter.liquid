{%- comment -%} PC ERA — Newsletter / email capture {%- endcomment -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="wrap wrap--narrow newsletter" data-reveal>
    {% render 'seal', size: 104 %}
    <span class="eyebrow" style="display:block;margin-top:1.4rem">{{ section.settings.eyebrow }}</span>
    <h2 class="h-display" style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    <p class="lead" style="max-width:520px;margin-inline:auto">{{ section.settings.subheading }}</p>
    {%- form 'customer', data-newsletter: true -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required aria-label="Email address">
      <button type="submit">{{ section.settings.button }} →</button>
    {%- endform -%}
    <p class="muted" data-newsletter-note style="font-size:.8rem;margin-top:1rem">{{ section.settings.note }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "butter", "label": "Butter" }, { "value": "ivory", "label": "Ivory" }, { "value": "warm", "label": "Beige" }, { "value": "ink", "label": "Soft black" }
    ], "default": "butter" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the era" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first chapter" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Be first to new arrivals, restocks and private edits. No noise — only the good stuff." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "button", "label": "Button", "default": "Join" },
    { "type": "text", "id": "note", "label": "Note", "default": "By subscribing you agree to receive PC Era emails. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
