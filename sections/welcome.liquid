{%- comment -%} PC ERA — Welcome {%- endcomment -%}
<section class="section welcome bg-{{ section.settings.bg }}">
  <div class="wrap wrap--reading text-center welcome__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h-display welcome__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="rte lead welcome__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link }}" class="btn welcome__cta">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Welcome",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "ivory", "label": "Ivory" }, { "value": "warm", "label": "Beige" }, { "value": "butter", "label": "Butter" }
    ], "default": "ivory" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to PC Era" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Affordable luxury, made to dress every era of her. Soft, confident pieces for slow mornings, golden hours and every version of you — welcome to your era.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Welcome" }]
}
{% endschema %}
