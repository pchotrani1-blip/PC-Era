{%- comment -%}
  PC ERA product card
  Params: product (object), badge (string, optional), reveal_delay (number)
  Editorial: dual-image hover, wishlist, quick-add, colour swatches.
{%- endcomment -%}
{%- liquid
  assign img1 = product.featured_media
  assign img2 = product.media[1]
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<article class="product-card" data-reveal {% if reveal_delay %}data-reveal-delay="{{ reveal_delay }}"{% endif %}>
  <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">
    {%- if badge -%}<span class="product-card__badge">{{ badge }}</span>
    {%- elsif on_sale -%}<span class="product-card__badge">Last chance</span>
    {%- elsif product.tags contains 'new' -%}<span class="product-card__badge">New in</span>
    {%- endif -%}
    {%- if img1 -%}
      <img class="is-first" src="{{ img1 | image_url: width: 700 }}" srcset="{{ img1 | image_url: width: 400 }} 400w, {{ img1 | image_url: width: 700 }} 700w" sizes="(max-width:640px) 50vw, 25vw" alt="{{ img1.alt | default: product.title | escape }}" loading="lazy" width="700" height="933">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__media' }}
    {%- endif -%}
    {%- if img2 -%}
      <img class="is-second" src="{{ img2 | image_url: width: 700 }}" alt="" loading="lazy" width="700" height="933">
    {%- endif -%}
  </a>

  <button class="product-card__wish" data-wish="{{ product.id }}" aria-label="Save to wishlist">
    {% render 'icon', name: 'heart', width: 18, height: 18 %}
  </button>

  {%- if product.available -%}
    <div class="quick-add">
      <button class="btn btn--light btn--block" data-add-to-cart="{{ product.selected_or_first_available_variant.id }}">
        Quick add
      </button>
    </div>
  {%- endif -%}

  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    <div class="product-card__price">
      {%- if on_sale -%}
        <s>{{ product.compare_at_price | money }}</s><span class="price--sale">{{ product.price | money }}</span>
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </div>
    {%- assign color_opt = product.options_with_values | where: 'name', 'Color' | first -%}
    {%- if color_opt -%}
      <div class="swatches">
        {%- for v in color_opt.values limit: 5 -%}
          <span class="swatch" style="background:{{ v | downcase | replace: ' ', '' }}" title="{{ v }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>
