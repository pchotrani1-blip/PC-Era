{%- comment -%}
  PC ERA product card
  Params: product (object), badge (string, optional), reveal_delay (number)
  Editorial: swipeable image carousel, wishlist, quick-add, colour swatches.
{%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign imgs = product.images
-%}
<article class="product-card"{% unless no_reveal %} data-reveal {% if reveal_delay %}data-reveal-delay="{{ reveal_delay }}"{% endif %}{% endunless %}>
  <div class="product-card__media">
    {%- if badge -%}<span class="product-card__badge">{{ badge }}</span>
    {%- elsif on_sale -%}<span class="product-card__badge">Last chance</span>
    {%- elsif product.tags contains 'new' -%}<span class="product-card__badge">New in</span>
    {%- endif -%}

    <div class="pc-track" data-pc-track>
      {%- for image in imgs limit: 6 -%}
        <a href="{{ product.url }}" class="pc-cell" aria-label="{{ product.title | escape }}">
          {%- if forloop.first -%}
            <img src="{{ image | image_url: width: 600 }}" srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w" sizes="(max-width:640px) 50vw, 25vw" alt="{{ image.alt | default: product.title | escape }}" loading="lazy" decoding="async" width="600" height="800">
          {%- else -%}
            <img class="pc-defer" data-src="{{ image | image_url: width: 600 }}" data-srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w" sizes="(max-width:640px) 50vw, 25vw" alt="{{ image.alt | default: product.title | escape }}" loading="lazy" decoding="async" width="600" height="800">
          {%- endif -%}
        </a>
      {%- else -%}
        <a href="{{ product.url }}" class="pc-cell" aria-label="{{ product.title | escape }}">{{ 'product-1' | placeholder_svg_tag }}</a>
      {%- endfor -%}
    </div>

    {%- if imgs.size > 1 -%}
      <button type="button" class="pc-nav pc-nav--prev" data-pc-prev aria-label="Previous image">&lsaquo;</button>
      <button type="button" class="pc-nav pc-nav--next" data-pc-next aria-label="Next image">&rsaquo;</button>
      <div class="pc-dots">
        {%- for image in imgs limit: 6 -%}<span class="pc-dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <button class="product-card__wish" data-wish="{{ product.id }}" aria-label="Save to wishlist">
    {% render 'icon', name: 'heart', width: 18, height: 18 %}
  </button>

  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    <div class="product-card__price">
      {%- if on_sale -%}
        <s>{{ product.compare_at_price | money }}</s><span class="price--sale">{{ product.price | money }}</span>
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </div>
    {%- assign color_opt = product.options_with_values | where: 'name', 'Color' | first -%}
    {%- if color_opt -%}
      <div class="swatches">
        {%- for v in color_opt.values limit: 5 -%}
          <span class="swatch" style="background:{% render 'swatch-color', name: v %}" title="{{ v }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Always-visible add to cart with inline size picker — wrapped so it pins to card bottom {%- endcomment -%}
    {%- if product.available -%}
      <div class="card-atc-wrap"{% if product.variants.size > 1 and product.variants.size <= 8 %} data-atc-wrap{% endif %}>
        {%- if product.variants.size == 1 -%}
          <button type="button" class="card-atc" data-add-to-cart="{{ product.variants.first.id }}">Add to cart</button>
        {%- elsif product.variants.size <= 8 -%}
          <button type="button" class="card-atc" data-atc-toggle aria-expanded="false">Add to cart</button>
          <div class="card-sizes" data-atc-tray hidden>
            {%- for v in product.variants -%}
              <button type="button" class="card-size" data-add-to-cart="{{ v.id }}"{% unless v.available %} disabled aria-disabled="true"{% endunless %} title="{{ v.title | escape }}">{{ v.title }}</button>
            {%- endfor -%}
          </div>
        {%- else -%}
          <a href="{{ product.url }}" class="card-atc">Select options</a>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="card-atc-wrap">
        <button type="button" class="card-atc card-atc--soldout" disabled>Sold out</button>
      </div>
    {%- endif -%}
  </div>
</article>
