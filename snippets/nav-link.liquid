{%- comment -%} Renders one primary-nav link; dropdown when it has children. Param: link {%- endcomment -%}
{%- if link.links.size > 0 -%}
  <details class="nav-group">
    <summary>{{ link.title }}<span class="nav-plus" aria-hidden="true"></span></summary>
    <div class="nav-submenu">
      {%- for child in link.links -%}
        <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>
      {%- endfor -%}
    </div>
  </details>
{%- else -%}
  {%- assign link_url = link.url -%}
  {%- assign link_title_dc = link.title | downcase -%}
  {%- if link_title_dc contains 'new arrival' -%}
    {%- assign link_url = collections['new-arrivals'].url | default: '/collections/new-arrivals' -%}
  {%- endif -%}
  <a href="{{ link_url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
{%- endif -%}
