{%- comment -%}
  PC ERA rotating seal/stamp logo.
  Params: variant ('gold'|'ivory'), size (px)
{%- endcomment -%}
{%- liquid
  assign logo = 'pc-era-logo.png'
  if variant == 'ivory'
    assign logo = 'pc-era-logo-ivory.png'
  endif
-%}
<div class="seal{% if variant == 'ivory' %} seal--ivory{% endif %}"{% if size %} style="--seal:{{ size }}px"{% endif %}>
  <svg class="seal__ring" viewBox="0 0 120 120" aria-hidden="true">
    <defs><path id="seal-{{ variant | default: 'gold' }}" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
    <text><textPath href="#seal-{{ variant | default: 'gold' }}">PC ERA · THE ERA OF TREND · PC ERA · THE ERA OF TREND · </textPath></text>
  </svg>
  <div class="seal__disc"></div>
  <img class="seal__logo" src="{{ logo | asset_url }}" alt="{{ shop.name }}" width="62" loading="lazy">
</div>
{%- unless variant == 'ivory' -%}
<style>.seal--ivory .seal__disc{background:#34302a;border-color:var(--champagne)}.seal--ivory .seal__ring text{fill:var(--ivory)}</style>
{%- endunless -%}
